#!/bin/bash
# Launcher of DistributedCryptography.app: starts the local web server of the wallet, opens the browser and
# stops the server when the app is quit.

PORT="5000"
APP_URL="http://localhost:$PORT/wallet.wallets.aspx"
SERVER="bin/GxWebStartup"

# <app>/Contents/MacOS/launch_app  ->  <app>/Contents/Resources/kestrel_app
CONTENTS_DIR="$(dirname "$(cd "$(dirname "$0")" && pwd)")"
APP_DIR="$CONTENTS_DIR/Resources/kestrel_app"

SERVER_PID=""

alert() {
    osascript -e "display alert \"Distributed Cryptography\" message \"$1\" as critical"
}

# Stops the server: first asks, then forces after 5 seconds
cleanup() {
    trap - SIGINT SIGTERM EXIT
    if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" > /dev/null 2>&1; then
        kill "$SERVER_PID"
        for _ in 1 2 3 4 5; do
            kill -0 "$SERVER_PID" > /dev/null 2>&1 || exit 0
            sleep 1
        done
        kill -9 "$SERVER_PID"
    fi
    exit 0
}
trap cleanup SIGINT SIGTERM EXIT

if [ ! -f "$APP_DIR/$SERVER" ]; then
    alert "A part of the application is missing ($SERVER). Please install it again."
    exit 1
fi
chmod +x "$APP_DIR/$SERVER"

# The server finds its pages and settings relative to this folder
cd "$APP_DIR" || exit 1

# Listens on this computer only
"./$SERVER" --urls "http://localhost:$PORT" > /dev/null 2>&1 &
SERVER_PID=$!

# Wait until the wallet page answers (up to 60 seconds). The page is asked for, not just the port: on a Mac
# other services (AirPlay Receiver) may also answer on port 5000.
for _ in $(seq 1 120); do
    if ! kill -0 "$SERVER_PID" > /dev/null 2>&1; then
        SERVER_PID=""
        alert "The application could not start. Check that no other program is using port $PORT."
        exit 1
    fi
    [ "$(curl -s -o /dev/null -w '%{http_code}' "$APP_URL")" = "200" ] && break
    sleep 0.5
done

open "$APP_URL"

# Stay alive while the server runs. Quitting the app (Dock or Cmd+Q) sends SIGTERM: cleanup stops the server.
wait "$SERVER_PID"
