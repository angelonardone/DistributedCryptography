<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
	
	
	<PropertyGroup>
		<AssemblyName>wallet.encryptedlocalfiles</AssemblyName>
		<TargetFramework>$(TargetFramework)</TargetFramework>
		<OutputType>Library</OutputType>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<PostgresqlSupport>false</PostgresqlSupport>
		<OfficeSupport>false</OfficeSupport>
		<MailSupport>false</MailSupport>
		<GrpcClientSupport>false</GrpcClientSupport>
		<PdfLibrary></PdfLibrary>
		<SAPErpSupport>false</SAPErpSupport>
		<PDFSupport>false</PDFSupport>
		<SearchSupport>false</SearchSupport>
	</PropertyGroup>

	<ItemGroup>

        <ProjectReference Include="..\GeneXus.Programs.Common\GeneXus.Programs.Common.csproj" >
            <OutputItemType>$(CommonOutputItemType)</OutputItemType>
        </ProjectReference>

	</ItemGroup>

	<ItemGroup>

        <Reference Include="WebExtensionToolkit" >
            <HintPath>$(WebBinDirectory)\WebExtensionToolkit.dll</HintPath>
        </Reference>
        <Reference Include="Google.Authenticator" >
            <HintPath>$(WebBinDirectory)\Google.Authenticator.dll</HintPath>
        </Reference>
        <Reference Include="GxInternetLib" >
            <HintPath>$(WebBinDirectory)\GxInternetLib.dll</HintPath>
        </Reference>
        <Reference Include="DistricutedCryptographyLib" >
            <HintPath>$(WebBinDirectory)\DistricutedCryptographyLib.dll</HintPath>
        </Reference>
        <Reference Include="GxJadeLib" >
            <HintPath>$(WebBinDirectory)\GxJadeLib.dll</HintPath>
        </Reference>

	</ItemGroup>

	<ItemGroup>
		<Compile Include = "$(WebDirectory)\wallet\savejsonencfile.cs" />
		<Compile Include = "$(WebDirectory)\distributedcryptographylib\encryptjson.cs" />
		<Compile Include = "$(WebDirectory)\wallet\getwallet.cs" />
		<Compile Include = "$(WebDirectory)\wallet\getprivatetempdir.cs" />
		<Compile Include = "$(WebDirectory)\wallet\downloadfile.cs" />
		<Compile Include = "$(WebDirectory)\wallet\preparelocalfiledownload.cs" />
		<Compile Include = "$(WebDirectory)\wallet\isosunix.cs" />
		<Compile Include = "$(WebDirectory)\distributedcryptographylib\decryptjson.cs" />
		<Compile Include = "$(WebDirectory)\wallet\readallfiles.cs" />
		<Compile Include = "$(WebDirectory)\nbitcoin\eccdecrypt.cs" />
		<Compile Include = "$(WebDirectory)\wallet\safefilename.cs" />
		<Compile Include = "$(WebDirectory)\wallet\storelocalfile.cs" />
		<Compile Include = "$(WebDirectory)\wallet\readjsonencfile.cs" />
		<Compile Include = "$(WebDirectory)\distributedcrypto\filedecryptv2.cs" />
		<Compile Include = "$(WebDirectory)\wallet\setlastjasonencritpedkey.cs" />
		<Compile Include = "$(WebDirectory)\nbitcoin\eccenctrypt.cs" />
		<Compile Include = "$(WebDirectory)\wallet\getdfaultjasonkey.cs" />
		<Compile Include = "$(WebDirectory)\distributedcrypto\fileencryptv2.cs" />
		<Compile Include = "$(WebDirectory)\wallet\insertintoallfiles.cs" />
		<Compile Include = "$(WebDirectory)\wallet\stagedownload.cs" />
		<Compile Include = "$(WebDirectory)\wallet\getlogindistcrypt.cs" />
		<Compile Include = "$(WebDirectory)\wallet\deleteoneencryptelfiles.cs" />
		<Compile Include = "$(WebDirectory)\wallet\encryptedlocalfiles.cs" />

	</ItemGroup>

	<Import Project="..\DotNetCoreBaseProject.targets"/>	
</Project>

