---
// Shows the published SHA-256 of a download. The value is read from the current release on GitHub each time
// the page is opened, so it always matches the file behind the download link.
import { releaseApi, releasePage, downloadUrl } from '../downloads';

interface Props {
	/** Name of the file in the release, for example DistributedCryptography-Windows-x64.zip */
	file: string;
}
const { file } = Astro.props;
---

<div class="sha256" data-sha256-file={file} data-sha256-api={releaseApi}>
	<code class="sha256-value">Loading…</code>
	<span class="sha256-version"></span>
</div>
<p class="sha256-link">
	If the value is not shown, open the <a href={releasePage}>release page</a>: it lists the SHA-256 of every file,
	and so does <a href={downloadUrl('SHA256SUMS.txt')}>SHA256SUMS.txt</a>.
</p>

<script>
	// One request for the whole page, also when it shows several files
	const boxes = document.querySelectorAll<HTMLElement>('[data-sha256-file]');
	if (boxes.length > 0) {
		const show = (box: HTMLElement, value: string, version = '') => {
			box.querySelector('.sha256-value')!.textContent = value;
			box.querySelector('.sha256-version')!.textContent = version;
		};
		fetch(boxes[0].dataset.sha256Api!, { headers: { Accept: 'application/vnd.github+json' } })
			.then((answer) => (answer.ok ? answer.json() : Promise.reject(new Error(String(answer.status)))))
			.then((release) => {
				const published = new Date(release.published_at).toLocaleDateString(undefined, { dateStyle: 'long' });
				boxes.forEach((box) => {
					const asset = (release.assets ?? []).find((a: { name: string }) => a.name === box.dataset.sha256File);
					const digest: string = asset?.digest ?? '';
					if (digest.startsWith('sha256:')) {
						show(box, digest.slice('sha256:'.length), `Version ${release.tag_name}, published ${published}`);
					} else {
						show(box, 'Not available here. Use the links below.');
					}
				});
			})
			.catch(() => boxes.forEach((box) => show(box, 'Could not be loaded. Use the links below.')));
	}
</script>

<style>
	.sha256 {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}
	.sha256-value {
		overflow-wrap: anywhere;
		background: none;
		padding: 0;
	}
	.sha256-version,
	.sha256-link {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
